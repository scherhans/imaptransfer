{
  "name": "imaptransfer-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "node scripts/with-greenmail.mjs pnpm --filter @imaptransfer/core test:integration",
    "greenmail": "node scripts/with-greenmail.mjs",
    "dev": "pnpm --filter @imaptransfer/core build && pnpm --filter imaptransfer-desktop dev",
    "dist": "pnpm build && pnpm --filter imaptransfer-desktop dist"
  }
}
