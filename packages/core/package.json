{
  "name": "@imaptransfer/core",
  "version": "0.2.2",
  "description": "Engine for backing up, restoring and migrating IMAP accounts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/unit/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --disable-warning=ExperimentalWarning \"test/integration/*.test.ts\""
  },
  "dependencies": {
    "imapflow": "^2.9.1",
    "libmime": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
